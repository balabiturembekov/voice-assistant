# Development Environment Variables
# Copy this to .env for local development

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Validate X-Twilio-Signature on /webhook/* (requires TWILIO_AUTH_TOKEN)
TWILIO_VALIDATE_REQUESTS=False

# AfterBuy API (required)
AFTERBUY_PARTNER_ID=your_partner_id
AFTERBUY_PARTNER_TOKEN=your_partner_token
AFTERBUY_ACCOUNT_TOKEN=your_account_token
AFTERBUY_USER_ID=your_user_id
AFTERBUY_USER_PASSWORD=your_user_password

# Company Information
WEBSITE_URL=http://localhost:5000

# Voice Configuration
VOICE_DE=Google.de-DE-Chirp3-HD-Aoede
VOICE_EN=Google.en-US-Chirp3-HD-Aoede

# Database (PostgreSQL container from docker-compose.yml)
POSTGRES_PASSWORD=change_me

# GDPR: anonymize calls older than N days (flask --app app purge-old-data); empty = off
DATA_RETENTION_DAYS=

# Flask Configuration (Development)
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-only-secret
SESSION_COOKIE_SECURE=False

# Email Configuration (for voice message notifications)
EMAIL_HOST=w01da240.kasserver.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=order@jvmoebel.de
EMAIL_HOST_PASSWORD=your_password_here
DEFAULT_FROM_EMAIL=order@jvmoebel.de
EMAIL_CHARSET=utf-8
EMAIL_CONTENT_TYPE=text/plain; charset=utf-8
MAIL_RECIPIENT=order@jvmoebel.de
# HELO hostname for SMTP (fixes "helo/hostname mismatch" errors)
# IMPORTANT: Should match the actual server hostname (EMAIL_HOST), not email domain
# Default: uses EMAIL_HOST (w01da240.kasserver.com)
# Only set this if your server requires a specific HELO hostname different from EMAIL_HOST
# MAIL_HELO_HOSTNAME=w01da240.kasserver.com

# Call flow v2
COMPANY_NAME=JV Möbel
# Team numbers, dialled simultaneously (comma separated, E.164)
AGENT_NUMBERS=+4973929378421
AGENT_DIAL_TIMEOUT=25
# Business hours for transfers (0=Mon..6=Sun), local time
BUSINESS_DAYS=0-4
BUSINESS_HOURS=08:00-17:00
TIMEZONE=Europe/Berlin
BUSINESS_HOURS_TEXT_DE=montags bis freitags von 8 bis 17 Uhr
BUSINESS_HOURS_TEXT_EN=Monday to Friday from 8 am to 5 pm
# Production time for the delivery estimate (weeks)
PRODUCTION_WEEKS=8-12
